# Public URL of the deployed site. Vercel sets this in Project Settings →
# Environment Variables. For local dev you can leave it unset; the app
# falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# --- Inquiry form delivery (Resend) ---
# The form silently logs submissions until these are set. As soon as
# RESEND_API_KEY *and* INQUIRY_TO_EMAIL are both present in the
# environment, submissions also go out by email — no code change needed.
#
# Get an API key at https://resend.com/api-keys.
# RESEND_API_KEY=

# Where new inquiries are delivered. Without a verified domain in Resend,
# this must be the email tied to the Resend account.
# INQUIRY_TO_EMAIL=

# From address. Defaults to Resend's test sender (onboarding@resend.dev),
# which is fine until you verify your own domain in Resend. After domain
# verification, set this to e.g. "Seaside Garage <hello@yourdomain.com>".
# INQUIRY_FROM_EMAIL=
