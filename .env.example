# Public URL of the deployed site. Vercel will inject the production URL
# automatically once you set this in Project Settings → Environment Variables.
# For local dev you can leave this unset; layout.tsx falls back to localhost.
NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# Resend API key for inquiry form delivery. Add when wiring up
# src/app/contact/actions.ts. Server-side only — must NOT be prefixed with
# NEXT_PUBLIC_.
# RESEND_API_KEY=

# Email address that inquiry form submissions should be sent to.
# INQUIRY_TO_EMAIL=hello@seasidegarageanddetailing.com
